# @defaultRequired=false @defaultSensitive=false
# @currentEnv=$APP_ENV
# @generateTsTypes(path=env.d.ts, importMetaEnv=none)
# @import(./.env.workspace.local, allowMissing=true)
# ---

# @type=enum(development, preview, production, test)
APP_ENV=remap($VARLOCK_ENV, regex("preview"), preview, regex("production"), production, regex("prod"), production, regex("test"), test, regex(".*"), development)

# @type=port @required
APP_PORT=3000

# @type=url @optional
BASE_URL=
