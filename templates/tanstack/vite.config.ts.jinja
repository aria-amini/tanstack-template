				'shadcn/no-unknown-classes': [
					'error',
					{
						allow: [
							'text-2xs',
							'text-3xs',
							'text-4xs',
							'text-5xs',
							'leading-display',
							'animate-pending-slide',
						],
					},
				],
				'shadcn/no-restyle': [
					'error',
					{
						allow: ['layout'],
						contracts: [
							{ pattern: '^Card$', allow: ['layout', 'spacing', 'color'] },
							{ pattern: '^Button$', allow: ['layout'] },
						],
					},
				],
