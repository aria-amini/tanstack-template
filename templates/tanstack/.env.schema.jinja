# This env file uses @env-spec. See https://varlock.dev/env-spec
# ---
# @defaultRequired=false @defaultSensitive=false
# @currentEnv=$APP_ENV
# @generateTsTypes(path=env.d.ts, importMetaEnv=none)
# @encryptInjectedEnv=forEnv(production)
# @import(./.env.workspace.local, allowMissing=true)
# ---

# Set automatically by Railway and used to detect preview deployments.
RAILWAY_ENVIRONMENT_NAME=

# @type=enum(development, preview, production, test)
APP_ENV=if(isEmpty($RAILWAY_ENVIRONMENT_NAME), remap($VARLOCK_ENV, regex("preview"), preview, regex("production"), production, regex("prod"), production, regex("test"), test, regex(".*"), development), remap($RAILWAY_ENVIRONMENT_NAME, regex("production"), production, regex("prod"), production, regex(".*"), preview))

# @type=port @required
APP_PORT=

# @type=url @required
BASE_URL=

# @type=url @required
BETTER_AUTH_URL=if(forEnv(development), "http://localhost:${APP_PORT}", $BASE_URL)
# @sensitive @optional
BETTER_AUTH_SECRET_LOCAL=
# @required=forEnv(production, preview) @sensitive
BETTER_AUTH_SECRET=if(forEnv(development), ${BETTER_AUTH_SECRET_LOCAL})
# @required=forEnv(production, preview) @sensitive
OAUTH_PROXY_SECRET=

# @required @type=url @sensitive
DATABASE_URL=

{% if google_auth -%}
# Dev reuses one shared "Desktop app" OAuth client: Google accepts any
# loopback port for those without registration, so every app/workspace signs
# in through its own daemon without per-app console setup. Deployed
# environments use a dedicated "Web application" client injected at runtime.
# @required=forEnv(production, preview)
GOOGLE_CLIENT_ID=
# @required=forEnv(production, preview) @sensitive
GOOGLE_CLIENT_SECRET=

{% endif -%}
# S3-compatible object storage. Dev runs MinIO via docker-compose and creates
# the bucket on first use; production points at a pre-provisioned bucket. Only
# production requires the credentials.
# @required=forEnv(production)
AWS_S3_BUCKET_NAME=
# @required=forEnv(production)
AWS_REGION="us-east-1"
# @required=forEnv(production) @type=url
AWS_ENDPOINT_URL=
# @required=forEnv(production) @sensitive
AWS_ACCESS_KEY_ID=
# @required=forEnv(production) @sensitive
AWS_SECRET_ACCESS_KEY=

{% if posthog -%}
# @required=forEnv(production) @public
VITE_PUBLIC_POSTHOG_KEY=

{% endif -%}
{% if sentry -%}
# @required=forEnv(production)
VITE_PUBLIC_SENTRY_DSN=
# @required=forEnv(production) @sensitive
SENTRY_AUTH_TOKEN=
{%- endif %}
